# Database configuration (PostgreSQL)
# DATABASE_URL is used for pooled connections (e.g. Neon connection pooler)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shikshatrack?schema=public"
# DIRECT_URL is used for direct database connections (e.g. Neon direct compute for Prisma migrations)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/shikshatrack?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shikshatrack_test?schema=public"

# Backend server
PORT=5050
NODE_ENV=development
# JWT Authentication
# For production, generate a secure random secret using: openssl rand -base64 48
JWT_SECRET="replace_with_a_secure_random_secret_in_production"
JWT_EXPIRES_IN="7d"

# Frontend URL for CORS (comma-separated origins supported in production)
FRONTEND_URL="http://localhost:5173"

# Frontend Vite Backend API URL
VITE_API_URL="http://localhost:5050"

# AI Provider Configuration (Optional - ShikshaTrack includes built-in intelligent fallback)
# Supported providers: gemini, openai, mock
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL="gemini-1.5-flash"

# Offline sync secret
SYNC_SECRET="shiksha_sync_secure_token"
